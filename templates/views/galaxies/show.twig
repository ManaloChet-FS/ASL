{% extends "layouts/_default.twig" %}

{% block main %}
<div class="card">
	<div class="card-header">
		<h1>{{ galaxy.name }}</h1>
		<p>Size:{{ galaxy.size }}</p>
	</div>
	{% if galaxy.image is defined %}
		<img src="{{ galaxy.image }}" alt="{{ galaxy.name }}">
	{% endif %}
	<p>{{ galaxy.description }}</p>
	{% if galaxy.Stars.length >= 1 %}
		<p>Stars:</p>
		<ul>
		{# Lists all the stars associated with the galaxy #}
			{% for star in galaxy.Stars %}
				<li><a href="/stars/{{ star.id }}">{{star.name}}</a></li>
			{% endfor %}
		</ul>
	{% endif %}
	<div class="card-links">
		<div>
			<a href="/galaxies">&laquo; Back</a>
			<a href="/galaxies/{{ galaxy.id }}/edit">Edit</a>
		</div>
		<a class="delete" href="/galaxies/{{ galaxy.id }}/delete">Delete</a>
	</div>
</div>
{% endblock %}
