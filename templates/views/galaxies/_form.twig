{% extends "layouts/_default.twig" %}

{% block main %}
  {% if galaxy is defined %}
    <form action="/galaxies/{{ galaxy.id }}" method="POST" encType="multipart/form-data">
      <input type="hidden" name="id" value="{{ galaxy.id }}" />
  {% else %}
    <form action="/galaxies" method="POST" encType="multipart/form-data">
  {% endif %}

  <div class="control">
    <label>Name:</label>
    <input 
      type="text" 
      name="name" 
      {% if galaxy is defined %}
      value="{{ galaxy.name }}"
      {% endif %}
      autocomplete="off"
    />
  </div>
  <div class="control">
    <label>Size:</label>
    <input 
      type="text" 
      name="size" 
      {% if galaxy is defined %}
      value="{{ galaxy.size }}"
      {% endif %}
      autocomplete="off"
    />
  </div>
  <div class="control">
    <label>Description:</label>
    <textarea name="description">{{ galaxy.description }}</textarea>
  </div>
  <div class="control">
    {% if galaxy.image %}
      <label>Edit Image:</label>
      <img src="{{ galaxy.image }}" alt="{{ galaxy.name }}" />
    {% else %}
      <label>Upload Image:</label>    
    {% endif %}
    <input type="file" name="image" id="image">
  </div>

  <button type="submit">
  {% if galaxy is defined %}
  Update
  {% else %}
  Create
  {% endif %}
  Galaxy
  </button>

  </form>
{% endblock %}